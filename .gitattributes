# Default line-ending handling
* text=auto

# C# / .NET / XAML / XML
*.cs     text diff=csharp
*.csproj text
*.slnx   text
*.sln    text
*.xaml   text
*.xml    text
*.json   text
*.md     text

# Keep Windows batch & PowerShell scripts as CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Keep shell scripts as LF
*.sh     text eol=lf

# Binary assets
*.png    binary
*.jpg    binary
*.jpeg   binary
*.ico    binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.svg    text
