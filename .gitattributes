# Varsayılan satır sonu yönetimi
* text=auto

# C# / .NET / XAML / XML
*.cs     text diff=csharp
*.csproj text
*.slnx   text
*.sln    text
*.xaml   text
*.xml    text
*.json   text
*.md     text

# Windows toplu iş dosyaları her zaman CRLF kalmalıdır
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Kabuk betikleri LF kalmalıdır
*.sh     text eol=lf

# İkili (binary) varlıklar
*.png    binary
*.jpg    binary
*.jpeg   binary
*.ico    binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.svg    text
