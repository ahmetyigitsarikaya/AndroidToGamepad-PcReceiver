<Window x:Class="PcReceiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AndroidToGamepad • PC Receiver"
        Width="980"
        Height="660"
        MinWidth="860"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgRoot}"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Header Bar -->
        <Border Grid.Row="0"
                Background="{StaticResource BgHeader}"
                BorderBrush="{StaticResource BorderHeader}"
                BorderThickness="0,0,0,1"
                Padding="16,0,8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#122B1B"
                            BorderBrush="#22C55E"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="7,3"
                            Margin="0,0,10,0">
                        <TextBlock Text="X360"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentGreen}" />
                    </Border>
                    <TextBlock Text="AndroidToGamepad"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="  •  PC Receiver • ViGEm Xbox 360"
                               FontSize="12"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatusBadgeBorder"
                            Background="#1C2128"
                            BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,4"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot"
                                     Width="8"
                                     Height="8"
                                     Fill="{StaticResource AccentAmber}"
                                     Margin="0,0,7,0" />
                            <TextBlock x:Name="StatusBadgeText"
                                       Text="Hazırlanıyor"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" />
                        </StackPanel>
                    </Border>

                    <Button Content="—"
                            Style="{StaticResource WindowControlButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MinimizeButton_Click"
                            ToolTip="Küçült" />
                    <Button Content="✕"
                            Style="{StaticResource WindowCloseButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click"
                            ToolTip="Kapat" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Sunucu & Bağlantı Card -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Sunucu &amp; Bağlantı" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Port"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="12.5"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />

                            <TextBox x:Name="PortTextBox"
                                     Grid.Column="1"
                                     Text="28555"
                                     Style="{StaticResource DarkTextBoxStyle}"
                                     Margin="0,0,10,0" />

                            <Button x:Name="StartStopButton"
                                    Grid.Column="2"
                                    Content="Durdur"
                                    MinWidth="96"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Click="StartStopButton_Click" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="AdbButton"
                                    Grid.Column="0"
                                    Content="USB (ADB) Bağla"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="AdbButton_Click" />

                            <Button x:Name="JoyCplButton"
                                    Grid.Column="2"
                                    Content="joy.cpl Aç"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="JoyCplButton_Click" />
                        </Grid>

                        <!-- Conditional ViGEmBus Warning -->
                        <Border x:Name="VigemWarningBanner"
                                Visibility="Collapsed"
                                Background="#2C1215"
                                BorderBrush="{StaticResource AccentRed}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="ViGEmBus Sürücüsü Eksik"
                                           Foreground="#FCA5A5"
                                           FontWeight="SemiBold"
                                           FontSize="12" />
                                <TextBlock Text="Sanal Xbox 360 kolu oluşturmak için ViGEmBus kurulumu gereklidir."
                                           Foreground="#FECACA"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,8" />
                                <Button Content="ViGEmBus İndir"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Padding="10,6"
                                        FontSize="12"
                                        Click="DownloadVigemButton_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Bağlantı Adresleri Card -->
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Bağlantı Adresleri" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Kopyalamak için tıkla"
                                       Style="{StaticResource MutedLabelStyle}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <WrapPanel x:Name="IpPillsPanel" Orientation="Horizontal" />
                    </StackPanel>
                </Border>

                <!-- Olay Günlüğü Card -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Olay Günlüğü" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                            <Button Content="Temizle"
                                    Style="{StaticResource PillButtonStyle}"
                                    Padding="8,3"
                                    FontSize="11"
                                    HorizontalAlignment="Right"
                                    Click="ClearLogButton_Click" />
                        </Grid>

                        <Border Grid.Row="1"
                                Background="{StaticResource BgLog}"
                                BorderBrush="{StaticResource BorderHeader}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8">
                            <TextBox x:Name="LogTextBox"
                                     IsReadOnly="True"
                                     FontFamily="Consolas"
                                     FontSize="11.5"
                                     Foreground="#9CA3AF"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right Column -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Canlı Kontrolcü Önizleme Card -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Canlı Kontrolcü Önizleme" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="VisualizerHintText"
                                       Text="Girdi bekleniyor..."
                                       Style="{StaticResource MutedLabelStyle}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Viewbox Grid.Row="1" Stretch="Uniform" Margin="4">
                            <Canvas Width="600" Height="360">
                                <!-- LT & RT Analog Bars -->
                                <Border Canvas.Left="88" Canvas.Top="16" Width="128" Height="22"
                                        Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6">
                                    <Grid ClipToBounds="True">
                                        <Rectangle x:Name="LtBarFill" HorizontalAlignment="Left" Height="20" Width="0"
                                                   RadiusX="5" RadiusY="5" Fill="#22C55E" />
                                        <TextBlock x:Name="LtText" Text="LT  0%" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#E5E7EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Border Canvas.Left="384" Canvas.Top="16" Width="128" Height="22"
                                        Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6">
                                    <Grid ClipToBounds="True">
                                        <Rectangle x:Name="RtBarFill" HorizontalAlignment="Left" Height="20" Width="0"
                                                   RadiusX="5" RadiusY="5" Fill="#22C55E" />
                                        <TextBlock x:Name="RtText" Text="RT  0%" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#E5E7EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- LB & RB Bumpers -->
                                <Border x:Name="LbShape" Canvas.Left="104" Canvas.Top="46" Width="96" Height="24"
                                        Background="#1B222C" BorderBrush="#30363D" BorderThickness="1.5" CornerRadius="12,12,4,4">
                                    <TextBlock Text="LB" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <Border x:Name="RbShape" Canvas.Left="400" Canvas.Top="46" Width="96" Height="24"
                                        Background="#1B222C" BorderBrush="#30363D" BorderThickness="1.5" CornerRadius="12,12,4,4">
                                    <TextBlock Text="RB" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Controller Shell -->
                                <Path Stroke="#30363D" StrokeThickness="2"
                                      Data="M 145,74 C 210,68 390,68 455,74 C 525,80 562,135 568,225 C 574,300 546,342 505,342 C 472,342 448,312 426,294 C 392,296 355,296 300,278 C 245,296 208,296 174,294 C 152,312 128,342 95,342 C 54,342 26,300 32,225 C 38,135 75,80 145,74 Z">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#222935" Offset="0" />
                                            <GradientStop Color="#161B23" Offset="1" />
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>

                                <!-- Left Stick Well & Puck (center 155,155) -->
                                <Ellipse Canvas.Left="113" Canvas.Top="113" Width="84" Height="84"
                                         Fill="#0D1117" Stroke="#30363D" StrokeThickness="1.5" />
                                <Ellipse Canvas.Left="143" Canvas.Top="143" Width="24" Height="24"
                                         Stroke="#242C37" StrokeThickness="1" StrokeDashArray="2 2" />
                                <Ellipse x:Name="LsClickRing" Canvas.Left="111" Canvas.Top="111" Width="88" Height="88"
                                         Stroke="#22C55E" StrokeThickness="2.5" Opacity="0" />
                                <Grid x:Name="LsPuck" Canvas.Left="135" Canvas.Top="135" Width="40" Height="40">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="LsTransform" />
                                    </Grid.RenderTransform>
                                    <Ellipse x:Name="LsPuckCircle" Fill="#2D3644" Stroke="#5A6678" StrokeThickness="1.5" />
                                    <Ellipse Margin="6" Fill="#1E2530" Stroke="#3B4554" StrokeThickness="1" />
                                    <TextBlock Text="L" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>

                                <!-- D-Pad (center 225,240) -->
                                <Ellipse Canvas.Left="189" Canvas.Top="204" Width="72" Height="72"
                                         Fill="#0D1117" Stroke="#30363D" StrokeThickness="1.5" />
                                <Border x:Name="DpadUpShape" Canvas.Left="215" Canvas.Top="209" Width="20" Height="22"
                                        Background="#222935" CornerRadius="4,4,0,0" />
                                <Border x:Name="DpadDownShape" Canvas.Left="215" Canvas.Top="249" Width="20" Height="22"
                                        Background="#222935" CornerRadius="0,0,4,4" />
                                <Border x:Name="DpadLeftShape" Canvas.Left="194" Canvas.Top="230" Width="22" Height="20"
                                        Background="#222935" CornerRadius="4,0,0,4" />
                                <Border x:Name="DpadRightShape" Canvas.Left="234" Canvas.Top="230" Width="22" Height="20"
                                        Background="#222935" CornerRadius="0,4,4,0" />
                                <Rectangle Canvas.Left="215" Canvas.Top="230" Width="20" Height="20" Fill="#222935" />

                                <!-- Center Cluster: View, Guide, Menu -->
                                <Border x:Name="ViewShape" Canvas.Left="244" Canvas.Top="147" Width="26" Height="16"
                                        Background="#1B222C" BorderBrush="#3A4350" BorderThickness="1.2" CornerRadius="8">
                                    <TextBlock Text="◀" FontSize="8.5" Foreground="#9CA3AF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <Border x:Name="GuideShape" Canvas.Left="281" Canvas.Top="136" Width="38" Height="38"
                                        Background="#151A22" BorderBrush="#3A4350" BorderThickness="1.8" CornerRadius="19">
                                    <TextBlock x:Name="GuideLetter" Text="X" FontSize="15" FontWeight="Bold"
                                               Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <Border x:Name="MenuShape" Canvas.Left="330" Canvas.Top="147" Width="26" Height="16"
                                        Background="#1B222C" BorderBrush="#3A4350" BorderThickness="1.2" CornerRadius="8">
                                    <TextBlock Text="▶" FontSize="8.5" Foreground="#9CA3AF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Right Stick Well & Puck (center 375,240) -->
                                <Ellipse Canvas.Left="333" Canvas.Top="198" Width="84" Height="84"
                                         Fill="#0D1117" Stroke="#30363D" StrokeThickness="1.5" />
                                <Ellipse Canvas.Left="363" Canvas.Top="228" Width="24" Height="24"
                                         Stroke="#242C37" StrokeThickness="1" StrokeDashArray="2 2" />
                                <Ellipse x:Name="RsClickRing" Canvas.Left="331" Canvas.Top="196" Width="88" Height="88"
                                         Stroke="#22C55E" StrokeThickness="2.5" Opacity="0" />
                                <Grid x:Name="RsPuck" Canvas.Left="355" Canvas.Top="220" Width="40" Height="40">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="RsTransform" />
                                    </Grid.RenderTransform>
                                    <Ellipse x:Name="RsPuckCircle" Fill="#2D3644" Stroke="#5A6678" StrokeThickness="1.5" />
                                    <Ellipse Margin="6" Fill="#1E2530" Stroke="#3B4554" StrokeThickness="1" />
                                    <TextBlock Text="R" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Face Buttons (center 445,155) -->
                                <Border x:Name="BtnY" Canvas.Left="429" Canvas.Top="102" Width="32" Height="32"
                                        Background="#161B22" BorderBrush="#F59E0B" BorderThickness="2" CornerRadius="16">
                                    <TextBlock x:Name="BtnYText" Text="Y" FontSize="13" FontWeight="Bold" Foreground="#F59E0B"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <Border x:Name="BtnX" Canvas.Left="392" Canvas.Top="139" Width="32" Height="32"
                                        Background="#161B22" BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="16">
                                    <TextBlock x:Name="BtnXText" Text="X" FontSize="13" FontWeight="Bold" Foreground="#3B82F6"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <Border x:Name="BtnB" Canvas.Left="466" Canvas.Top="139" Width="32" Height="32"
                                        Background="#161B22" BorderBrush="#EF4444" BorderThickness="2" CornerRadius="16">
                                    <TextBlock x:Name="BtnBText" Text="B" FontSize="13" FontWeight="Bold" Foreground="#EF4444"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <Border x:Name="BtnA" Canvas.Left="429" Canvas.Top="176" Width="32" Height="32"
                                        Background="#161B22" BorderBrush="#22C55E" BorderThickness="2" CornerRadius="16">
                                    <TextBlock x:Name="BtnAText" Text="A" FontSize="13" FontWeight="Bold" Foreground="#22C55E"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Border>

                <!-- Bottom Telemetry Strip -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.6*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="14,11">
                        <StackPanel>
                            <TextBlock Text="Paket Hızı" Style="{StaticResource MutedLabelStyle}" />
                            <TextBlock x:Name="HzText"
                                       Text="0 Hz"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentGreen}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="14,11">
                        <StackPanel>
                            <TextBlock Text="Toplam Paket" Style="{StaticResource MutedLabelStyle}" />
                            <TextBlock x:Name="PacketCountText"
                                       Text="0"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" Padding="14,11">
                        <StackPanel>
                            <TextBlock Text="Analog Değerler" Style="{StaticResource MutedLabelStyle}" />
                            <TextBlock x:Name="AxesText"
                                       Text="L: 0.00, 0.00 | R: 0.00, 0.00"
                                       FontFamily="Consolas"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
